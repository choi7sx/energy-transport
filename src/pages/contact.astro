---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">
  <section class="page-hero"><div class="shell"><p class="eyebrow">Start a conversation</p><h1>Tell us what needs to move.</h1><p>Whether you need dependable fuel transportation or want to learn more about working with our team, we are ready to help.</p></div></section>
  <section class="section"><div class="shell contact-layout"><div><p class="eyebrow">Contact Energy Transport</p><h2 class="content-title">A real person is ready to talk.</h2><div class="contact-detail"><span>Email</span><a href="mailto:info@energytransport.com">info@energytransport.com</a></div><div class="contact-detail"><span>Visit</span><p>600 Pickwick St<br />Savannah, TN 38372</p></div></div><form class="inquiry-form" action="mailto:info@energytransport.com?subject=Quote%20request" method="post" enctype="text/plain" data-contact-form><h2>Request a quote</h2><div class="form-grid"><div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div><div class="field"><label for="company">Company</label><input id="company" name="company" autocomplete="organization" /></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" inputmode="email" autocomplete="email" required /></div><div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" /></div><div class="field full"><label for="fuel">What can we help with?</label><select id="fuel" name="fuel"><option>Fuel transportation</option><option>Gasoline delivery</option><option>Ethanol delivery</option><option>Diesel delivery</option><option>Career opportunity</option><option>Something else</option></select></div><div class="field full"><label for="message">A few details</label><textarea id="message" name="message" placeholder="Tell us about your location, delivery needs, or question."></textarea></div></div><p class="form-status" aria-live="polite"></p><button class="button" type="submit">Send inquiry <span aria-hidden="true">→</span></button></form></div></section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const status = form?.querySelector<HTMLElement>(".form-status");

  form?.addEventListener("submit", () => {
    const data = new FormData(form);
    const labels: Record<string, string> = {
      name: "Name",
      company: "Company",
      email: "Email",
      phone: "Phone",
      fuel: "Service needed",
      message: "Details",
    };
    const body = [...data.entries()]
      .filter(([, value]) => String(value).trim())
      .map(([key, value]) => `${labels[key] ?? key}: ${value}`)
      .join("\n");

    form.action = `mailto:info@energytransport.com?${new URLSearchParams({ subject: "Quote request", body }).toString()}`;
    if (status) status.textContent = "Your email app will open with your inquiry ready to send.";
  });
</script>
