---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">
  <section class="page-hero"><div class="shell"><p class="eyebrow">Start a conversation</p><h1>Tell us what needs to move.</h1><p>Whether you need dependable fuel transportation or want to learn more about working with our team, we are ready to help.</p></div></section>
  <section class="section"><div class="shell contact-layout"><div><p class="eyebrow">Contact Energy Transport</p><h2 class="content-title">A real person is ready to talk.</h2><div class="contact-detail"><span>Email</span><a href="mailto:info@energytransport.com">info@energytransport.com</a></div><div class="contact-detail"><span>Visit</span><p>600 Pickwick St<br />Savannah, TN 38372</p></div></div><form class="inquiry-form" action="mailto:info@energytransport.com?subject=Quote%20request" method="post" enctype="text/plain" data-contact-form><h2>Request a quote</h2><div class="form-grid"><div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div><div class="field"><label for="company">Company</label><input id="company" name="company" autocomplete="organization" /></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" inputmode="email" autocomplete="email" required /></div><div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" /></div><div class="field full"><label class="field-label" id="fuel-label" for="fuel-trigger">What can we help with?</label><div class="custom-select" data-custom-select><select id="fuel" name="fuel" aria-labelledby="fuel-label"><option>Fuel transportation</option><option>Gasoline delivery</option><option>Ethanol delivery</option><option>Diesel delivery</option><option>Career opportunity</option><option>Something else</option></select><button class="custom-select-trigger" id="fuel-trigger" type="button" aria-expanded="false" aria-haspopup="listbox" aria-controls="fuel-options" aria-labelledby="fuel-label fuel-value"><span id="fuel-value">Fuel transportation</span><svg aria-hidden="true" viewBox="0 0 16 16"><path d="m3 6 5 5 5-5" /></svg></button><div class="custom-select-options" id="fuel-options" role="listbox" aria-labelledby="fuel-label" hidden><button type="button" role="option" aria-selected="true" data-select-option="0">Fuel transportation</button><button type="button" role="option" aria-selected="false" data-select-option="1">Gasoline delivery</button><button type="button" role="option" aria-selected="false" data-select-option="2">Ethanol delivery</button><button type="button" role="option" aria-selected="false" data-select-option="3">Diesel delivery</button><button type="button" role="option" aria-selected="false" data-select-option="4">Career opportunity</button><button type="button" role="option" aria-selected="false" data-select-option="5">Something else</button></div></div></div><div class="field full"><label for="message">A few details</label><textarea id="message" name="message" placeholder="Tell us about your location, delivery needs, or question."></textarea></div></div><p class="form-status" aria-live="polite"></p><button class="button" type="submit">Send inquiry <span aria-hidden="true">→</span></button></form></div></section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const status = form?.querySelector<HTMLElement>(".form-status");

  document.querySelectorAll<HTMLElement>("[data-custom-select]").forEach((picker) => {
    const select = picker.querySelector<HTMLSelectElement>("select");
    const trigger = picker.querySelector<HTMLButtonElement>(".custom-select-trigger");
    const value = picker.querySelector<HTMLElement>("#fuel-value");
    const listbox = picker.querySelector<HTMLElement>(".custom-select-options");
    const options = [...picker.querySelectorAll<HTMLButtonElement>("[data-select-option]")];

    if (!select || !trigger || !value || !listbox) return;

    picker.classList.add("is-ready");

    const close = (returnFocus = false) => {
      listbox.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      if (returnFocus) trigger.focus();
    };

    const open = (focusSelected = false) => {
      listbox.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      if (focusSelected) options[select.selectedIndex]?.focus();
    };

    const syncValue = (index: number) => {
      select.selectedIndex = index;
      value.textContent = select.options[index]?.text ?? "";
      options.forEach((option, optionIndex) => option.setAttribute("aria-selected", String(optionIndex === index)));
    };

    trigger.addEventListener("click", () => listbox.hidden ? open() : close());
    trigger.addEventListener("keydown", (event) => {
      if (["ArrowDown", "ArrowUp", "Enter", " "].includes(event.key)) {
        event.preventDefault();
        open(true);
      }
    });

    options.forEach((option, index) => {
      option.addEventListener("click", () => {
        syncValue(index);
        select.dispatchEvent(new Event("change", { bubbles: true }));
        close(true);
      });
      option.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          close(true);
        }
      });
    });

    select.addEventListener("change", () => syncValue(select.selectedIndex));
    document.addEventListener("click", (event) => {
      if (!picker.contains(event.target as Node)) close();
    });
  });

  form?.addEventListener("submit", () => {
    const data = new FormData(form);
    const labels: Record<string, string> = {
      name: "Name",
      company: "Company",
      email: "Email",
      phone: "Phone",
      fuel: "Service needed",
      message: "Details",
    };
    const body = [...data.entries()]
      .filter(([, value]) => String(value).trim())
      .map(([key, value]) => `${labels[key] ?? key}: ${value}`)
      .join("\n");

    form.action = `mailto:info@energytransport.com?${new URLSearchParams({ subject: "Quote request", body }).toString()}`;
    if (status) status.textContent = "Your email app will open with your inquiry ready to send.";
  });
</script>
