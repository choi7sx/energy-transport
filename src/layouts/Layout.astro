---
import "../styles/main.css";
import site from "../../data/site.json";
import { footer } from "../../data/navigation.json";
import Header from "../components/navigation/header.astro";
import Footer from "../components/navigation/footer.astro";
import ContactCta from "../components/cta/contact-cta.astro";
import { SEO } from "astro-seo";

export interface SEOProps {
  page_description?: string | null;
  featured_image?: string | null;
  featured_image_alt?: string | null;
  canonical_url?: string | null;
  no_index?: boolean | null;
  open_graph_type?: string | null;
  author_twitter_handle?: string | null;
}

export interface Props {
  title: string;
  seo?: SEOProps;
}

const { seo, title } = Astro.props;
const baseUrl = Astro.site ?? new URL("https://example.invalid/");

let pageTitle = "";
if (!title) {
  pageTitle = site.site_title;
} else if (Astro.url.pathname === "/") {
  pageTitle = title;
} else {
  pageTitle = `${title} | ${site.site_title}`;
}

const description = seo?.page_description ?? site.description;
const image = seo?.featured_image ?? site.image;
const imageAlt = seo?.featured_image_alt ?? site.image_alt;
const canonicalURL = new URL(seo?.canonical_url ?? Astro.url.pathname, baseUrl);
const imageURL = new URL(image, canonicalURL);
const siteURL = new URL("/", baseUrl);
const organizationId = `${siteURL.toString()}#organization`;
const pageType = seo?.open_graph_type === "article" ? "Article" : "WebPage";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: site.site_title,
      legalName: "Energy Transport Company LLC",
      url: siteURL.toString(),
      logo: new URL(site.logo, siteURL).toString(),
      description: site.description,
      email: footer.contact.email,
      address: {
        "@type": "PostalAddress",
        streetAddress: "600 Pickwick St",
        addressLocality: "Savannah",
        addressRegion: "TN",
        postalCode: "38372",
        addressCountry: "US",
      },
      areaServed: ["Tennessee", "Arkansas", "Mississippi", "Kentucky"].map((name) => ({
        "@type": "State",
        name,
      })),
    },
    {
      "@type": "WebSite",
      "@id": `${siteURL.toString()}#website`,
      url: siteURL.toString(),
      name: site.site_title,
      description: site.description,
      publisher: { "@id": organizationId },
      inLanguage: "en-US",
    },
    {
      "@type": pageType,
      "@id": `${canonicalURL.toString()}#webpage`,
      url: canonicalURL.toString(),
      name: pageTitle,
      description,
      image: imageURL.toString(),
      isPartOf: { "@id": `${siteURL.toString()}#website` },
      about: { "@id": organizationId },
      inLanguage: "en-US",
    },
  ],
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      noindex={Boolean(seo?.no_index)}
      title={pageTitle}
      description={description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title: pageTitle,
          url: canonicalURL.toString(),
          type: seo?.open_graph_type || "website",
          image: imageURL.toString(),
        },
        optional: { description },
        image: { url: imageURL.toString(), alt: imageAlt },
      }}
      twitter={{
        creator: `${seo?.author_twitter_handle || site.twitter_site}`,
        site: `${site.twitter_site}`,
        card: "summary_large_image",
      }}
    />
    <script type="application/ld+json" set:html={structuredDataJson} />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <ContactCta />
    <Footer />
    <script>
      if (window.inEditorMode) {
        import("../scripts/register-components.ts").catch((error) => {
          console.warn("Failed to load CloudCannon component registration:", error);
        });
      }
    </script>
  </body>
</html>
