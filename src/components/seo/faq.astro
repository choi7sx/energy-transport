---
type Item = {
  question: string;
  answer: string;
};

interface Props {
  heading?: string;
  items: Item[];
}

const { heading = "Frequently asked questions", items } = Astro.props;
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
const schemaJson = JSON.stringify(schema).replace(/</g, "\\u003c");
---

<section class="section section-tint">
  <div class="shell faq-list">
    <h2 class="content-title">{heading}</h2>
    {items.map((item) => (
      <details class="faq-item">
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={schemaJson} />
