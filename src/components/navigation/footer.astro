---
import { footer } from "../../../data/navigation.json";
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="footer-brand" href={footer.logo_url}>
        <img src={footer.logo} alt={footer.logo_alt_text} />
      </a>
      <p class="footer-intro">Reliable petroleum transportation, with the care and accountability of a family business.</p>
    </div>
    <div>
      <p class="footer-label">Explore</p>
      <nav class="footer-links" aria-label="Footer navigation">
        {footer.links.map((link) => <a href={link.link}>{link.text}</a>)}
      </nav>
    </div>
    <div>
      <p class="footer-label">Talk to our team</p>
      <a class="footer-contact" href={`mailto:${footer.contact.email}`}>{footer.contact.email}</a>
      <p class="footer-address">Energy Transport Company LLC<br />600 Pickwick St, Savannah, TN 38372</p>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} {footer.copyright}</span>
    <span>Safe delivery. Strong relationships.</span>
  </div>
</footer>
