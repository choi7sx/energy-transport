---
import { header } from "../../../data/navigation.json";
---

<header id="site-header" class="sticky top-0 z-40 bg-white transition-shadow duration-300">
  <div class="mx-auto max-w-6xl px-8">
    <nav id="site-nav" class="flex items-center justify-between py-4 transition-[padding] duration-300 ease-in-out">
      <a href={header.logo_url} class="shrink-0">
        <img id="site-logo" class="w-48 transition-all duration-300 ease-in-out" src={header.logo} alt={header.logo_alt_text} />
      </a>

      <div class="hidden sm:flex items-center">
        <ul id="nav-links" class="flex items-center gap-6 transition-all duration-300 ease-in-out">
          {header.links.map((link) => (
            <li class:list={["relative", { group: link.sublinks }]}>
              <a class="text-gray-700 hover:text-gray-500 transition-colors" href={link.link}>
                {link.text}
              </a>
              {link.sublinks && (
                <ul class="absolute left-0 top-full z-10 hidden min-w-40 flex-col rounded-md border border-gray-100 bg-white py-2 shadow-lg group-hover:flex group-focus-within:flex">
                  {link.sublinks.map((sublink) => (
                    <li>
                      <a
                        class="block px-4 py-2 text-gray-700 hover:bg-gray-50 hover:text-gray-500 transition-colors"
                        href={sublink.link}
                      >
                        {sublink.text}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
        {header.cta && (
          <a
            id="site-cta"
            class="ml-6 shrink-0 rounded-md bg-primary-600 px-4 py-2 text-white transition-all duration-300 ease-in-out hover:bg-primary-700"
            href={header.cta.link}
          >
            {header.cta.text}
          </a>
        )}
      </div>

      <button
        class="sm:hidden p-2"
        aria-label="Open navigation menu"
        popovertarget="mobile-menu"
        popovertargetaction="show"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <div popover id="mobile-menu" class="fixed inset-0 m-0 w-full h-full max-w-none max-h-none border-none bg-white z-50">
        <div class="flex flex-col h-full">
        <div class="mx-auto w-full max-w-6xl flex items-center justify-between px-8 py-4">
          <a href={header.logo_url}>
            <img class="w-48" src={header.logo} alt={header.logo_alt_text} />
          </a>
          <button
            class="p-2"
            aria-label="Close navigation menu"
            popovertarget="mobile-menu"
            popovertargetaction="hide"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <ul class="flex flex-1 flex-col items-center justify-center gap-0 divide-y divide-gray-200 overflow-y-auto">
          {header.links.map((link) => (
            <li class="w-full max-w-xs text-center">
              {link.sublinks ? (
                <details class="group/details">
                  <summary class="cursor-pointer list-none py-5 text-2xl font-medium text-gray-800 hover:text-gray-900 transition-colors">
                    {link.text}
                  </summary>
                  <ul class="flex flex-col gap-0 pb-4">
                    {link.sublinks.map((sublink) => (
                      <li>
                        <a class="block py-3 text-lg text-gray-600 hover:text-gray-900 transition-colors" href={sublink.link}>
                          {sublink.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a class="block py-5 text-2xl font-medium text-gray-800 hover:text-gray-900 transition-colors" href={link.link}>
                  {link.text}
                </a>
              )}
            </li>
          ))}
          {header.cta && (
            <li class="w-full max-w-xs text-center">
              <a class="block py-5 text-2xl font-medium text-primary-600 hover:text-primary-700 transition-colors" href={header.cta.link}>
                {header.cta.text}
              </a>
            </li>
          )}
        </ul>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  #mobile-menu {
    opacity: 0;
    transition: opacity 200ms ease, display 200ms allow-discrete, overlay 200ms allow-discrete;
  }
  #mobile-menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    #mobile-menu:popover-open {
      opacity: 0;
    }
  }

  #nav-links {
    max-width: 40rem;
    opacity: 1;
  }

  #site-header.is-minimized {
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
  }

  #site-header.is-minimized #site-nav {
    padding-top: 0.625rem;
    padding-bottom: 0.625rem;
  }

  #site-header.is-minimized #site-logo {
    width: 8rem;
  }

  #site-header.is-minimized #site-cta {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
  }

  #site-header.is-minimized #nav-links {
    max-width: 0;
    opacity: 0;
    gap: 0;
    overflow: hidden;
    pointer-events: none;
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const SCROLL_THRESHOLD = 80;
  const MIN_DELTA = 10;
  let lastScrollY = window.scrollY;
  let ticking = false;

  function updateHeader() {
    const currentScrollY = Math.max(window.scrollY, 0);
    const delta = currentScrollY - lastScrollY;

    if (currentScrollY <= SCROLL_THRESHOLD) {
      header?.classList.remove("is-minimized");
      lastScrollY = currentScrollY;
    } else if (Math.abs(delta) > MIN_DELTA) {
      header?.classList.toggle("is-minimized", delta > 0);
      lastScrollY = currentScrollY;
    }

    ticking = false;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeader);
        ticking = true;
      }
    },
    { passive: true },
  );
</script>
