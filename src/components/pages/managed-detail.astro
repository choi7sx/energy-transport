---
import Layout from "../../layouts/Layout.astro";
import Faq from "../seo/faq.astro";

const { page } = Astro.props;
---

<Layout title={page.title} seo={page.seo}>
  <section class="page-hero"><div class="shell"><p class="eyebrow">{page.hero.eyebrow}</p><h1>{page.hero.heading}</h1><p>{page.hero.lead}</p></div></section>
  <section class="section section-tint"><div class="shell content-grid">{page.cards.map((card: { eyebrow: string; heading: string; text: string; link?: string; link_text?: string }) => <article class="detail-card"><p class="eyebrow">{card.eyebrow}</p><h2>{card.heading}</h2><p>{card.text}</p>{card.link && card.link_text && <a class="text-link" href={card.link}>{card.link_text} →</a>}</article>)}</div></section>
  {page.faqs?.length > 0 && <Faq items={page.faqs} />}
</Layout>
