---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="About Energy Transport Company" seo={{ page_description: "Learn about Energy Transport Company, a family-owned fuel transportation business serving Tennessee and the Mid-South since 1989.", open_graph_type: "website" }}>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-8">
      <h1
        data-editable="source"
        data-path="src/content/pages/about.astro"
        data-key="heading"
        class="type-title-page mb-8 text-balance">
        About Energy Transport
      </h1>
      <div
        data-editable="source"
        data-path="src/content/pages/about.astro"
        data-key="description"
        class="prose text-lg text-gray-600">
        <p>
          Energy Transport Company is a family-owned fuel transportation business
          serving Tennessee and the Mid-South since 1989. We deliver gasoline,
          ethanol, and diesel with the steady communication, safe handling, and
          personal accountability our customers depend on.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-20 bg-gray-50">
    <div class="mx-auto max-w-3xl px-8">
      <h2
        data-editable="source"
        data-path="src/content/pages/about.astro"
        data-key="contact_heading"
        class="type-title-section mb-6 text-balance">
        Built on dependable relationships
      </h2>
      <div
        data-editable="source"
        data-path="src/content/pages/about.astro"
        data-key="contact_details"
        class="prose text-lg text-gray-600">
        <p>
          Our team serves customers throughout Tennessee, Arkansas, Mississippi,
          and Kentucky. From dispatch to delivery, we focus on safe work, clear
          communication, and the kind of service that keeps operations moving.
          <a href="/contact/">Contact Energy Transport to request a quote.</a>
        </p>
      </div>
    </div>
  </section>
</Layout>
